<?xml version="1.0" encoding="utf-8"?>
<settings>
  <category label="Language and location">
    <setting type="action" label="Language and location" action="RunScript(script.stremioelec,locale)" />
  </category>
  <category label="Stremio addons">
    <setting id="manifest" type="text" label="Catalog addon manifest URL" default="https://v3-cinemeta.strem.io/manifest.json" />
  </category>
  <category label="Built-in weather">
    <setting id="weather_location" type="text" label="Weather location" default="" />
    <setting id="weather_lat" type="text" label="Weather latitude" default="" />
    <setting id="weather_lon" type="text" label="Weather longitude" default="" />
  </category>
  <category label="Appearance">
    <setting id="ui_focus_color" type="enum" label="Poster focus color" values="Original|Purple|Blue|Green|Gold" default="0" />
    <setting id="ui_animations" type="bool" label="Enable animations" default="true" />
    <setting id="ui_dim_rows" type="bool" label="Dim rows while the side menu is open" default="false" />
    <setting id="ui_show_logo" type="bool" label="Use title logo (otherwise show text)" default="true" />
    <setting id="ui_show_plot" type="bool" label="Show description" default="true" />
    <setting id="ui_show_rating" type="bool" label="Show rating" default="true" />
    <setting id="ui_show_genres" type="bool" label="Show genres" default="true" />
    <setting id="ui_show_runtime" type="bool" label="Show runtime" default="true" />
    <setting type="lsep" label="Reopen the addon to apply appearance changes." />
  </category>
  <category label="Cache and maintenance">
    <setting type="action" label="Cache information" action="RunScript(script.stremioelec,cache_info)" />
    <setting type="action" label="Clear addon browsing and ratings cache" action="RunScript(script.stremioelec,cache_clear)" />
    <setting type="lsep" label="Clearing the cache refreshes data on next load. Your login and library are kept." />
  </category>
  <category label="Ratings">
    <setting id="mdblist_api_key" type="text" option="hidden" label="MDbList API key" default="" />
    <setting id="rating_imdb" type="bool" label="Show IMDb rating" default="true" />
    <setting id="rating_tmdb" type="bool" label="Show TMDb rating" default="false" />
    <setting id="rating_trakt" type="bool" label="Show Trakt rating" default="false" />
    <setting id="rating_tomatoes" type="bool" label="Show Rotten Tomatoes rating" default="false" />
    <setting id="rating_metacritic" type="bool" label="Show Metacritic rating" default="false" />
    <setting id="rating_letterboxd" type="bool" label="Show Letterboxd rating" default="false" />
    <setting id="rating_tomatoesaudience" type="bool" label="Show RT Audience rating" default="false" />
    <setting id="rating_metacriticuser" type="bool" label="Show Metacritic User rating" default="false" />
    <setting id="rating_myanimelist" type="bool" label="Show MyAnimeList rating" default="false" />
    <setting type="action" label="Import API key from Nimbus" action="RunScript(script.stremioelec,import_mdblist)" />
    <setting type="lsep" label="Optional. Ratings are cached for 24 hours. Reopen addon after changes." />
  </category>
  <category label="Trailers">
    <setting id="trailers_enabled" type="bool" label="Enable trailers" default="true" />
    <setting id="trailers_provider" type="enum" label="Trailer playback provider" values="Automatic|SlyGuy Trailers|YouTube" default="0" />
    <setting id="trailers_auto" type="bool" label="Automatically play trailer on details screen" default="false" />
    <setting id="trailers_delay" type="enum" label="Autoplay delay" values="3 seconds|5 seconds|10 seconds|15 seconds|30 seconds" default="2" />
    <setting type="lsep" label="Any navigation cancels autoplay. Requires an installed trailer provider." />
  </category>
  <category label="Home and playback">
    <setting id="tmdb_api_key" type="text" option="hidden" label="TMDb API key (optional override for trailers)" default="" />
    <setting type="action" label="Stremio subtitles for current video" action="RunPlugin(plugin://script.stremioelec/?action=subtitles)" />
    <setting type="lsep" label="Languages and automatic subtitle download follow Kodi Player settings." />
    <setting type="lsep" label="Unverified HDMI: decoded audio; display mode switching off. Decoder defaults retained." />
  </category>
</settings>
