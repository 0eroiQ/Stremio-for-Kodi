{
  "name": "Stremio for Kodi",
  "plugin": "script.stremioelec",
  "priority": 1,
  "is_resolvable": "true",
  "assert": {"play_movie": ["imdb"], "play_episode": ["imdb", "season", "episode"]},
  "play_movie": "plugin://script.stremioelec/?action=helper_play&kind=movie&imdb={imdb}",
  "play_episode": "plugin://script.stremioelec/?action=helper_play&kind=series&imdb={imdb}&season={season}&episode={episode}"
}
